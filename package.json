{
  "name": "dsh-path-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Path-level access control for AI file access, effective even under danger-full-access.",
  "license": "GPL-3.0-or-later",
  "author": "苏拾柒 <seventeen_su@proton.me>",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
